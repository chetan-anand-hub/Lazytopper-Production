// storage.rules -- RECORD ONLY, NOT DEPLOYED FROM THIS REPO.
//
// This file is a copy, kept under version control, of the Firebase Storage
// rules that are live in the Firebase console. firebase.json does not list a
// "storage" target, so `firebase deploy` never reads this file; editing it
// changes nothing in production. [FU-STORAGE-RULES-IN-REPO]
//
// What the handoffs state (12 Nov 2026): the bucket is private by default;
// only `ncert/` and `cbse/` are public (read). `packs/` (pack templates) and
// `stamped/` (per-buyer stamped copies and ZIPs; a bucket lifecycle rule
// deletes `stamped/` after 2 days) are private. The server reads and signs
// links with the Admin SDK / service account, which bypasses these rules.
//
// VERIFY AGAINST THE CONSOLE: the exact live rule text was not available when
// this file was written. This is the minimal rule set the handoffs describe,
// not a verbatim export. If the console differs, the console wins; paste its
// text here and say so in the commit.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /ncert/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /cbse/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    // Everything else (including packs/ and stamped/) is private to clients.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
