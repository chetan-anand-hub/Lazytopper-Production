<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f0fdf4;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#dbeafe;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <rect x="40" y="40" width="1120" height="550" rx="24" fill="#ffffff" stroke="#e5e5e5" stroke-width="2"/>
  
  <!-- Logo -->
  <rect x="80" y="80" width="56" height="56" rx="14" fill="#58cc02"/>
  <text x="108" y="116" font-family="Arial,sans-serif" font-size="22" font-weight="900" fill="#ffffff" text-anchor="middle">LT</text>
  <text x="150" y="115" font-family="Arial,sans-serif" font-size="28" font-weight="800" fill="#3c3c3c">LazyTopper</text>

  <!-- Badge -->
  <rect x="80" y="160" width="280" height="36" rx="18" fill="#e6f9e0" stroke="#c4eeb8" stroke-width="1.5"/>
  <text x="220" y="184" font-family="Arial,sans-serif" font-size="14" font-weight="700" fill="#46a302" text-anchor="middle">CBSE CLASS 10 — MATHS &amp; SCIENCE</text>

  <!-- Main headline -->
  <text x="80" y="240" font-family="Arial,sans-serif" font-size="42" font-weight="800" fill="#3c3c3c">Know what's</text>
  <text x="80" y="290" font-family="Arial,sans-serif" font-size="42" font-weight="800" fill="#58cc02">most likely to appear</text>
  <text x="80" y="340" font-family="Arial,sans-serif" font-size="42" font-weight="800" fill="#3c3c3c">in your board exam.</text>

  <!-- Sub text -->
  <text x="80" y="390" font-family="Arial,sans-serif" font-size="18" fill="#777777">10 years of CBSE data analysed · AI Tutor · Predicted Questions</text>
  <text x="80" y="418" font-family="Arial,sans-serif" font-size="18" fill="#777777">500+ practice questions · Mock tests · Free to start</text>

  <!-- CTA button -->
  <rect x="80" y="450" width="240" height="52" rx="16" fill="#58cc02"/>
  <text x="200" y="483" font-family="Arial,sans-serif" font-size="17" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="0.5">START FREE</text>

  <!-- Stats on right -->
  <rect x="720" y="160" width="400" height="380" rx="20" fill="#f7f7f7" stroke="#e5e5e5" stroke-width="1.5"/>
  <text x="920" y="200" font-family="Arial,sans-serif" font-size="14" font-weight="700" fill="#777777" text-anchor="middle">TOP PREDICTED TOPICS</text>
  
  <!-- Bar 1 -->
  <text x="750" y="240" font-family="Arial,sans-serif" font-size="14" font-weight="700" fill="#3c3c3c">Quadratic Equations</text>
  <rect x="750" y="248" width="340" height="14" rx="7" fill="#e5e5e5"/>
  <rect x="750" y="248" width="312" height="14" rx="7" fill="#58cc02"/>
  <text x="1098" y="260" font-family="Arial,sans-serif" font-size="13" font-weight="900" fill="#58cc02" text-anchor="end">92%</text>

  <!-- Bar 2 -->
  <text x="750" y="295" font-family="Arial,sans-serif" font-size="14" font-weight="700" fill="#3c3c3c">Light — Reflection</text>
  <rect x="750" y="303" width="340" height="14" rx="7" fill="#e5e5e5"/>
  <rect x="750" y="303" width="299" height="14" rx="7" fill="#58cc02"/>
  <text x="1098" y="315" font-family="Arial,sans-serif" font-size="13" font-weight="900" fill="#58cc02" text-anchor="end">88%</text>

  <!-- Bar 3 -->
  <text x="750" y="350" font-family="Arial,sans-serif" font-size="14" font-weight="700" fill="#3c3c3c">Arithmetic Progressions</text>
  <rect x="750" y="358" width="340" height="14" rx="7" fill="#e5e5e5"/>
  <rect x="750" y="358" width="289" height="14" rx="7" fill="#1cb0f6"/>
  <text x="1098" y="370" font-family="Arial,sans-serif" font-size="13" font-weight="900" fill="#1cb0f6" text-anchor="end">85%</text>

  <!-- Bar 4 -->
  <text x="750" y="405" font-family="Arial,sans-serif" font-size="14" font-weight="700" fill="#3c3c3c">Chemical Reactions</text>
  <rect x="750" y="413" width="340" height="14" rx="7" fill="#e5e5e5"/>
  <rect x="750" y="413" width="278" height="14" rx="7" fill="#1cb0f6"/>
  <text x="1098" y="425" font-family="Arial,sans-serif" font-size="13" font-weight="900" fill="#1cb0f6" text-anchor="end">82%</text>

  <!-- Bar 5 -->
  <text x="750" y="460" font-family="Arial,sans-serif" font-size="14" font-weight="700" fill="#3c3c3c">Electricity</text>
  <rect x="750" y="468" width="340" height="14" rx="7" fill="#e5e5e5"/>
  <rect x="750" y="468" width="265" height="14" rx="7" fill="#ff9600"/>
  <text x="1098" y="480" font-family="Arial,sans-serif" font-size="13" font-weight="900" fill="#ff9600" text-anchor="end">78%</text>

  <!-- Rating -->
  <text x="920" y="520" font-family="Arial,sans-serif" font-size="15" font-weight="800" fill="#3c3c3c" text-anchor="middle">★ 4.8 from 2,340+ reviews</text>

  <!-- Bottom bar -->
  <rect x="40" y="560" width="1120" height="30" rx="0" fill="#58cc02"/>
  <text x="600" y="581" font-family="Arial,sans-serif" font-size="13" font-weight="700" fill="#ffffff" text-anchor="middle">lazytopper.app — Free CBSE Class 10 Exam Prep with AI</text>
</svg>
