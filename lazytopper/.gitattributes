# Keep repo stable across Windows/mac/Linux
* text=auto

# Force LF for config/docs/scripts that frequently cause phantom diffs
# (avoid Windows phantom diffs in CI and workflows)
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
