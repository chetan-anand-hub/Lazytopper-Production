# Keep repo stable across Windows/mac/Linux
* text=auto

# Force LF for config/docs/scripts that frequently cause phantom diffs
# (avoid Windows phantom diffs in CI and workflows)
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
# HTML joins the list because `* text=auto` above normalises it to LF in the INDEX but
# still checks it out as CRLF on Windows: `git ls-files --eol` reports every one of the
# 106 tracked .html files as `i/lf w/crlf attr/text=auto`. Adding this rule therefore
# changes the CHECKOUT only and stages no renormalisation — the committed bytes are
# already LF. It matters before generated HTML is committed again: a generator writing
# the working-tree file back would otherwise hand CRLF to a guard that reads committed
# bytes, which passes on Windows and fails on the linux runner. `generateSitemap.ts:102`
# carries a hand-rolled LF workaround for exactly this shape.
*.html text eol=lf

# Generated by `pnpm seo:capture` — the prerendered page bodies the build applies.
# Marked generated so GitHub collapses them in a diff by default: a content lane's
# review should open on the source change, not on 3.8 MB of captured DOM. They are
# still versioned, still reviewable when expanded, and still required to be complete.
prerendered/** linguist-generated=true
