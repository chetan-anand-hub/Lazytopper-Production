{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // `scripts/generateSitemap.ts` is checked HERE, and it was previously checked
  // NOWHERE. tsconfig.app.json includes only `src`, tsconfig.test.json extends it,
  // and this project listed only `vite.config.ts` — so a build-time script under
  // `lazytopper/scripts/` compiled in no project at all and shipped whatever type
  // errors it had (it runs through `tsx`, which strips types without checking
  // them). This is the right project for it: same Node target, same bundler
  // resolution, and it is already wired into `tsc -b` through tsconfig.json.
  //
  // `vite/client` is in `types` FOR that script, and it is load-bearing, not
  // cargo: the generator reaches `src/config/canonicalUrl.ts`, whose
  // `appBasename()` reads `import.meta.env.BASE_URL`. Without those ambient types
  // this project fails with TS2339 "Property 'env' does not exist on type
  // 'ImportMeta'" — verified by removing it.
  "include": ["vite.config.ts", "scripts/generateSitemap.ts"]
}
