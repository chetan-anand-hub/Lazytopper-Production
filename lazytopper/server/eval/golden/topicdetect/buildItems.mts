// TOPIC-FIX-1 §2.1 - builds the chapter-detection eval set from SERVED bank rows with a known topicKey.
// Run from lazytopper/:  node --import tsx server/eval/golden/topicdetect/buildItems.mts
// Deterministic (sha1-ordered picks), official rows only (AI-generated ids excluded), typed stems only.
import { createHash } from "node:crypto";
import { writeFileSync } from "node:fs";
import { canonicalQuestionBank, AI_GENERATED_QUESTION_IDS } from "../../../../src/data/canonicalQuestionBank";

const VOCAB = (await import("../truth/topic_vocab.json", { with: { type: "json" } })).default as Array<{ slug: string; name: string; subject: string }>;
const h = (s: string) => createHash("sha1").update(s).digest("hex");
const FIG = /\b(figure|fig\.|diagram|shown below|given below in the figure|graph|image|picture)\b/i;
const rows = (canonicalQuestionBank as any[])
  .filter((r) => !AI_GENERATED_QUESTION_IDS.has(r.id))
  .filter((r) => typeof r.questionText === "string" && r.questionText.length >= 40 && r.questionText.length <= 420)
  .filter((r) => !FIG.test(r.questionText) && !r.options && Number(r.marks) >= 2)
  .sort((a, b) => (h(a.id) < h(b.id) ? -1 : 1));
const bySlug = new Map<string, any[]>();
for (const r of rows) (bySlug.get(r.topicKey) ?? bySlug.set(r.topicKey, []).get(r.topicKey)!).push(r);

const chosen = new Map<string, { row: any; kind: string }>();
const take = (r: any, kind: string) => { if (r && !chosen.has(r.id)) chosen.set(r.id, { row: r, kind }); };
for (const v of VOCAB) for (const r of (bySlug.get(v.slug) ?? []).slice(0, 2)) take(r, "chapter");
const trig = (bySlug.get("trigonometry") ?? []).filter((r) => /\b(prove|show)\s+that\b/i.test(r.questionText) && /\b(sin|cos|tan|cot|sec|cosec)/i.test(r.questionText) && /=/.test(r.questionText));
for (const r of trig.slice(0, 10)) take(r, "trig-identity");
const PAIRS: Array<[string, string]> = [["polynomials", "quadratic-equations"], ["arithmetic-progression", "real-numbers"], ["light-reflection-and-refraction", "human-eye-and-colourful-world"], ["acids-bases-and-salts", "chemical-reactions-and-equations"], ["heredity", "how-do-organisms-reproduce"], ["circles", "areas-related-to-circles"]];
for (const [a, b] of PAIRS) for (const s of [a, b]) for (const r of (bySlug.get(s) ?? []).slice(2, 3)) take(r, "confusable");

const items = [...chosen.values()].map(({ row, kind }) => ({
  id: row.id, kind, topicKey: row.topicKey, subject: VOCAB.find((v) => v.slug === row.topicKey)?.subject ?? row.subject,
  marks: row.marks, text: row.questionText,
}));
const out = new URL("./items.json", import.meta.url);
writeFileSync(out, JSON.stringify({ _readme: "TOPIC-FIX-1 eval set (generated by buildItems.mts from served OFFICIAL bank rows; typed stems).", baseSha: "1ee42404", items }, null, 1));
const count = (k: string) => items.filter((i) => i.kind === k).length;
console.log(JSON.stringify({ total: items.length, chapter: count("chapter"), trig: count("trig-identity"), confusable: count("confusable"), chaptersCovered: new Set(items.map((i) => i.topicKey)).size, trigPool: trig.length }));
