modules = ["nodejs-24", "postgresql-16"]

  [[artifacts]]
  id = "artifacts/api-server"

  [[artifacts]]
  id = "artifacts/mockup-sandbox"

  [deployment]
  router = "application"
  deploymentTarget = "autoscale"

  [deployment.build]
  args = ["pnpm", "run", "build"]

  [deployment.build.env]
  NODE_ENV = "production"

  [deployment.postBuild]
  args = ["pnpm", "store", "prune"]
  env = { "CI" = "true" }

  [workflows]
runButton = "Project"

  [[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "LazyTopper Gateway"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Verify production build is fresh"

  [[workflows.workflow]]
  name = "LazyTopper Gateway"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "cd lazytopper && node server/index.cjs"
  waitForPort = 3001

  [workflows.workflow.metadata]
  outputType = "console"

[[workflows.workflow]]
name = "Verify production build is fresh"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/verify-production-build.mjs"

[workflows.workflow.metadata]
isValidation = true

  [agent]
  stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0", "google-drive:1.0.0"]

  [postMerge]
  path = "scripts/post-merge.sh"
timeoutMs = 120000

  [userenv]

  [userenv.shared]
  AI_PROVIDER = "gemini"

  [nix]
  channel = "stable-25_05"
  