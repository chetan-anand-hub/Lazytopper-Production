{
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lazytopper-production-production.up.railway.app/api/:path*"
    },
    {
      "source": "/shared-api/:path*",
      "destination": "https://lazytopper-production-production.up.railway.app/shared-api/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/app/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/app/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/app/llms.txt"
    },
    {
      "source": "/favicon.svg",
      "destination": "/app/favicon.svg"
    },
    {
      "source": "/a6c1861da61f4d36898e5e27a71c36d6.txt",
      "destination": "/app/a6c1861da61f4d36898e5e27a71c36d6.txt"
    },
    {
      "source": "/questions/:path(.*)",
      "destination": "/app/questions/:path"
    },
    {
      "source": "/app/:path(.*)",
      "destination": "/app/index.html"
    }
  ]
}
