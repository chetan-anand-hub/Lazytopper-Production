# Keep the Docker build context lean. CRITICAL: exclude ONLY things that are rebuilt
# (node_modules, build outputs) or are irrelevant at runtime (.git, editor/agent dirs).
# Do NOT exclude any application source — the AI gateway compiles lazytopper/src/**/*.ts
# from source at runtime, so excluding "dead-looking" source would break it.

# Reinstalled fresh by `pnpm install --frozen-lockfile`
**/node_modules

# Not needed at runtime
.git
.github
.claude

# Build outputs — regenerated by `pnpm run build`
artifacts/api-server/dist
artifacts/lazytopper-app/dist
lazytopper/dist

# Local env / secrets must never enter the image (set in the Railway dashboard instead)
**/.env
**/.env.local

# Noise
**/*.log
**/.DS_Store
