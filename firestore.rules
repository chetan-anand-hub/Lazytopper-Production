// Deploy these rules using the Firebase CLI:
//   firebase deploy --only firestore:rules
//
// Requires a .firebaserc pointing to your Firebase project, or run:
//   firebase use --add   (to select a project)
//
// These rules enforce per-UID access: each authenticated student can only
// read and write documents under their own UID path.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Learner profiles and all subcollections (sessions, messages, mistakeLogs)
    match /sessionRecords/{uid} {
      allow read, write: if isOwner(uid);
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /learnerProfiles/{uid} {
      allow read, write: if isOwner(uid);

      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /mistakeLogs/{logId} {
        allow read, write: if isOwner(uid);
      }

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Dashboard UI preferences
    match /dashboardPrefs/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Core progress snapshot (chapter stats, attempts, mastery, streaks, badges)
    match /learnerProgress/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Subscription status (trial + premium)
    match /subscriptions/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Practice analytics — written client-side, read for insights panels
    match /practiceInsights/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Mock exam score history — written client-side
    match /mockScoreHistory/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Weak area aggregation — computed and written client-side
    match /weakAreaSummary/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Topic mastery percentages map — written client-side
    match /topicMastery/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Spaced repetition schedule (FSRS) — written client-side
    match /srSchedules/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // AI-generated personalised learning path — written client-side
    match /learningPaths/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
