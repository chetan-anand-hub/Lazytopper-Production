// Deploy these rules using the Firebase CLI:
//   firebase deploy --only firestore:rules
//
// Requires a .firebaserc pointing to your Firebase project, or run:
//   firebase use --add   (to select a project)
//
// These rules enforce per-UID access: each authenticated student can only
// read and write documents under their own UID path.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Learner profiles and all subcollections (sessions, messages, mistakeLogs)
    match /sessionRecords/{uid} {
      allow read, write: if isOwner(uid);
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /learnerProfiles/{uid} {
      allow read, write: if isOwner(uid);

      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /mistakeLogs/{logId} {
        allow read, write: if isOwner(uid);
      }

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Dashboard UI preferences
    match /dashboardPrefs/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Core progress snapshot (chapter stats, attempts, mastery, streaks, badges)
    match /learnerProgress/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Subscription status (trial + premium)
    //
    // ★ SECURITY — the client may CACHE an entitlement, it must never GRANT one.
    // Before this rule, `allow read, write: if isOwner(uid)` let any signed-in
    // student open devtools and write tier:"premium" into their own document.
    //
    // A blanket `allow write: if false` is NOT the fix: subscriptionService's
    // `activateTrial` writes tier:"trial" / plan:"trial_7day" straight from the
    // browser and there is no server endpoint for it, so denying all client
    // writes would break trial activation for every new student.
    //
    // The predicate therefore ALLOWLISTS the two tiers and two plans the client is
    // entitled to write. An allowlist, not a denylist: a denylist of the paid
    // values would silently admit any tier or plan added later.
    //
    // ★ There is deliberately NO nested `match /{document=**}` block here, and one
    // must never be re-added. In rules_version '2' a recursive wildcard matches
    // ZERO or more segments, so a nested `/{document=**}` also matches THIS parent
    // document path — and because Firestore ORs its match blocks, a permissive
    // nested block re-grants exactly what this block denies. An earlier attempt at
    // this fix restricted the parent, left the nested block permissive, and was a
    // complete no-op; it read as a fix, which is the dangerous part.
    //
    // Removing the block is safe because nothing writes a subcollection under
    // subscriptions/{uid}: the only writer in the product is
    // subscriptionService.saveCloud, which setDoc()s THIS document. Verified across
    // lazytopper/src, lazytopper/server (firebase-admin) and artifacts/api-server.
    // Subcollection paths now fall through to the deny-all catch-all at the bottom.
    //
    // ★ SEC-2 — [FU-TRIAL-ENDDATE-CLIENT-FORGEABLE] is CLOSED HERE, together with the
    // subscriptionService change that stops writing/reading trialEndDate.
    //
    // The residual PR-1 recorded was: isPremiumAccess() treats "trial" exactly like
    // "premium" (correct — the trial is a full 7-day trial), while the trial's END was
    // a client-supplied ISO *string* that the client trusted. Rules have no
    // string-to-timestamp parser, so the stored end could never be validated here.
    //
    // The fix is not to validate the forgeable field, it is to REMOVE it:
    //   START     server-pinned to request.time, set ONCE, immutable
    //   DURATION  a constant in code (subscriptionService.TRIAL_DAYS)
    //   END       derived — never stored, never trusted
    //
    // ★★ PINNING THE START IS NOT ENOUGH ON ITS OWN. If a client could write
    // trialStartDate == request.time whenever it liked, a student would re-trigger it
    // daily and hold an infinite trial — the same forged-length defect in a new
    // costume. So the start is pinned on FIRST set and immutable thereafter, and
    // delete is refused so the document cannot be dropped and re-created to reset the
    // clock. All three are pinned by emulator tests 9/10/11/12 in
    // firestore-rules-tests/subscriptions.rules.test.mjs, each mutation-verified.
    match /subscriptions/{uid} {
      // The only tier/plan pairs a browser is allowed to put in this document.
      function clientWritableEntitlement() {
        return request.resource.data.tier in ['free', 'trial']
            && request.resource.data.plan in ['none', 'trial_7day'];
      }

      // "Unset" means absent OR explicitly null. defaultStatus() carries a null
      // trialStartDate, so treating a stored null as "set" would deny every
      // legitimate later activation. Both spellings must mean the same thing.
      function trialStartUnset(d) {
        return !('trialStartDate' in d) || d.trialStartDate == null;
      }

      // request.time is server-set; a client writing serverTimestamp() produces
      // exactly it, and a client writing any value of its own choosing does not.
      function trialStartServerPinned() {
        return trialStartUnset(request.resource.data)
            || request.resource.data.trialStartDate == request.time;
      }

      // Once a start exists it may never move — not forward, not backward, and it
      // may not be erased (writing null over it fails this comparison, and dropping
      // the field with a non-merge set makes the field access error, which denies).
      function trialStartImmutable() {
        return trialStartUnset(resource.data)
            ? trialStartServerPinned()
            : ('trialStartDate' in request.resource.data
               && request.resource.data.trialStartDate == resource.data.trialStartDate);
      }

      // trialEndDate is the forgeable field this lane removes; the client no longer
      // writes it. Rules refuse to let any client INTRODUCE or MOVE it. A legacy
      // document's existing value may ride along unchanged in a merge write (and may
      // be nulled out), so a pre-existing document is never locked out of the expiry
      // write-back — it just cannot be used to buy time.
      function trialEndDateNotForged() {
        return !('trialEndDate' in request.resource.data)
            || request.resource.data.trialEndDate == null
            || (resource != null
                && 'trialEndDate' in resource.data
                && request.resource.data.trialEndDate == resource.data.trialEndDate);
      }

      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && clientWritableEntitlement()
                    && trialStartServerPinned()
                    && trialEndDateNotForged();
      allow update: if isOwner(uid)
                    && clientWritableEntitlement()
                    && trialStartImmutable()
                    && trialEndDateNotForged();
      // ★ Explicit. Nothing in the product deletes a subscription document, and a
      // student who could would reset their own trial clock by deleting and
      // re-creating. Stated rather than left to the catch-all so that a later edit
      // re-adding `write` cannot silently restore delete along with it.
      allow delete: if false;
    }

    // Practice analytics — written client-side, read for insights panels
    match /practiceInsights/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Mock exam score history — written client-side
    match /mockScoreHistory/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Weak area aggregation — computed and written client-side
    match /weakAreaSummary/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Topic mastery percentages map — written client-side
    match /topicMastery/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Spaced repetition schedule (FSRS) — written client-side
    match /srSchedules/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // AI-generated personalised learning path — written client-side
    match /learningPaths/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Durable tutor chat sessions — thread + doubts/coverage session-memory,
    // per student, per topic. D-TUT-8 honesty guard: NEVER a grade/score. Same
    // per-UID isolation as every other collection (cf. sessionRecords/{uid}).
    match /tutorSessions/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
